def video_duration_seconds(video_path: Path) -> float:
    cap = cv2.VideoCapture(str(video_path))
    if not cap.isOpened():
        raise RuntimeError(f"Could not open video: {video_path}")

    fps = cap.get(cv2.CAP_PROP_FPS)
    count = cap.get(cv2.CAP_PROP_FRAME_COUNT)
    cap.release()

    if fps and fps > 0 and count and count > 0:
        return float(count / fps)
    return float("inf")


def sample_segment_frames(
    video_path: Path,
    start_sec: float,
    end_sec: float,
    num_frames: int,
) -> List[Image.Image]:
    duration = video_duration_seconds(video_path)
    start = max(0.0, float(start_sec))
    end = min(float(end_sec), duration)

    if not np.isfinite(end):
        end = float(end_sec)

    if end <= start:
        raise RuntimeError(
            f"Invalid segment interval for {video_path.name}: {start} -> {end}"
        )

    # Sample at bin midpoints so the first/last decoded frames are not exact
    # boundary frames from adjacent annotated minutes.
    edges = np.linspace(start, end, num_frames + 1)
    times = (edges[:-1] + edges[1:]) / 2.0

    cap = cv2.VideoCapture(str(video_path))
    if not cap.isOpened():
        raise RuntimeError(f"Could not open video: {video_path}")

    frames = []

    for ts in times:
        cap.set(cv2.CAP_PROP_POS_MSEC, float(ts) * 1000.0)
        ok, bgr = cap.read()

        if not ok:
            continue

        rgb = cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB)
        frames.append(Image.fromarray(rgb))

    cap.release()

    if len(frames) < max(4, num_frames // 2):
        raise RuntimeError(
            f"Only {len(frames)}/{num_frames} frames decoded from "
            f"{video_path.name} at {start:.1f}-{end:.1f}s."
        )

    return frames


class FrameCache:
    def __init__(
        self,
        cache_root: Path,
        cropper: PatientCropper,
        num_frames: int,
    ):
        self.root = cache_root
        self.cropper = cropper
        self.num_frames = int(num_frames)
        self.root.mkdir(parents=True, exist_ok=True)

    def sample_dir(self, sample_id: str) -> Path:
        safe = re.sub(r"[^A-Za-z0-9_.-]+", "_", sample_id)
        return self.root / safe

    def load_cached(self, directory: Path) -> Optional[List[Image.Image]]:
        files = sorted(directory.glob("frame_*.jpg"))

        if len(files) != self.num_frames:
            return None

        return [
            Image.open(p).convert("RGB")
            for p in files
        ]

    def build(self, row) -> List[Image.Image]:
        directory = self.sample_dir(str(row.sample_id))
        cached = self.load_cached(directory)

        if cached is not None:
            return cached

        frames = sample_segment_frames(
            Path(row.video_path),
            float(row.start_sec),
            float(row.end_sec),
            self.num_frames,
        )

        # If decode returned slightly fewer frames, deterministically resample
        # the decoded set to the requested count.
        if len(frames) != self.num_frames:
            idxs = np.linspace(
                0,
                len(frames) - 1,
                self.num_frames,
                dtype=int,
            )
            frames = [frames[int(i)] for i in idxs]

        side = str(row.patient_side)
        if side not in {"left", "right"}:
            raise RuntimeError(
                f"No valid patient_side for {row.sample_id}: {side!r}"
            )

        frames = self.cropper.crop(frames, side)

        directory.mkdir(parents=True, exist_ok=True)

        for i, frame in enumerate(frames, start=1):
            frame.save(
                directory / f"frame_{i:03d}.jpg",
                quality=92,
                subsampling=0,
            )

        write_json(
            directory / "meta.json",
            {
                "sample_id": str(row.sample_id),
                "video_path": str(row.video_path),
                "start_sec": float(row.start_sec),
                "end_sec": float(row.end_sec),
                "patient_side": side,
                "num_frames": self.num_frames,
            },
        )

        return frames


