def safe_spearman(y_true: np.ndarray, y_pred: np.ndarray) -> float:
    if len(y_true) < 3:
        return float("nan")
    if np.allclose(y_true, y_true[0]):
        return float("nan")
    try:
        return float(spearmanr(y_true, y_pred).statistic)
    except Exception:
        return float("nan")


def compute_metrics(
    rows: List[dict],
    positive_threshold: float,
) -> dict:
    if not rows:
        return {}

    df = pd.DataFrame(rows)

    metrics = {
        "n": int(len(df)),
        "WD_P_MAE": float(np.mean(np.abs(df["WD_P_true"] - df["WD_P_pred"]))),
        "CF_P_MAE": float(np.mean(np.abs(df["CF_P_true"] - df["CF_P_pred"]))),
        "WD_P_spearman": safe_spearman(
            df["WD_P_true"].to_numpy(),
            df["WD_P_pred"].to_numpy(),
        ),
        "CF_P_spearman": safe_spearman(
            df["CF_P_true"].to_numpy(),
            df["CF_P_pred"].to_numpy(),
        ),
    }

    true_any = (
        df[["WD_P_true", "CF_P_true"]].max(axis=1)
        >= positive_threshold
    ).astype(int).to_numpy()

    pred_score = df[["WD_P_pred", "CF_P_pred"]].max(axis=1).to_numpy()
    pred_any = (pred_score >= positive_threshold).astype(int)

    tp = int(np.sum((true_any == 1) & (pred_any == 1)))
    fp = int(np.sum((true_any == 0) & (pred_any == 1)))
    fn = int(np.sum((true_any == 1) & (pred_any == 0)))
    tn = int(np.sum((true_any == 0) & (pred_any == 0)))

    precision = tp / (tp + fp) if (tp + fp) else 0.0
    recall = tp / (tp + fn) if (tp + fn) else 0.0
    f1 = (
        2 * precision * recall / (precision + recall)
        if (precision + recall)
        else 0.0
    )

    metrics.update(
        {
            "rupture_any_TP": tp,
            "rupture_any_FP": fp,
            "rupture_any_FN": fn,
            "rupture_any_TN": tn,
            "rupture_any_precision": precision,
            "rupture_any_recall": recall,
            "rupture_any_f1": f1,
        }
    )

    if len(np.unique(true_any)) == 2 and average_precision_score is not None:
        try:
            metrics["rupture_any_AUPRC"] = float(
                average_precision_score(true_any, pred_score)
            )
            metrics["rupture_any_AUROC"] = float(
                roc_auc_score(true_any, pred_score)
            )
        except Exception:
            pass

    return metrics


