        help="Existing patient-side cache from the visual benchmark.",
    )
    p.add_argument(
        "--yunet-model",
        default=r".\models\face_detection_yunet\face_detection_yunet_2026may.onnx",
        help="YuNet face detector already used in the visual pipeline.",
    )

    # Pilot manifest.
    p.add_argument(
        "--manifest-out",
        default=r".\output\qwen3vl_rupture_finetune_pilot\pilot_manifest.csv",
    )
    p.add_argument("--min-coders", type=int, default=2)
    p.add_argument("--pilot-patients", type=int, default=8)
    p.add_argument("--segments-per-patient", type=int, default=15)
    p.add_argument("--positive-threshold", type=float, default=3.0)

    p.add_argument(
        "--require-role-cache",
        action=argparse.BooleanOptionalAction,
        default=True,
        help="Retain only videos whose patient left/right side is already cached.",
    )

    # Model.
    p.add_argument("--model-id", default=DEFAULT_MODEL_ID)
    p.add_argument(
        "--attn-implementation",
        default="sdpa",
        choices=["sdpa", "eager", "flash_attention_2"],
    )
    p.add_argument(
        "--no-4bit",
        action="store_true",
        help="Disable QLoRA 4-bit loading.",
    )

    # Visual input.
    p.add_argument(
        "--num-frames",
        type=int,
        default=32,
        help=(
            "Chronological frames across the labelled one-minute segment. "
            "Use 32 for the initial pilot."
        ),
    )
    p.add_argument("--frame-width", type=int, default=320)
    p.add_argument(
        "--frame-cache",
        default=r".\output\qwen3vl_rupture_finetune_pilot\frame_cache_32",
    )

    # LoRA and regression head.
    p.add_argument("--lora-r", type=int, default=16)
    p.add_argument("--lora-alpha", type=int, default=32)
    p.add_argument("--lora-dropout", type=float, default=0.05)
    p.add_argument("--head-dropout", type=float, default=0.10)

    # Training.
    p.add_argument("--epochs", type=int, default=2)
    p.add_argument("--learning-rate", type=float, default=1e-4)
    p.add_argument("--head-learning-rate", type=float, default=3e-4)
    p.add_argument("--weight-decay", type=float, default=0.01)
    p.add_argument("--grad-accum-steps", type=int, default=4)
    p.add_argument("--huber-beta", type=float, default=0.5)
    p.add_argument("--max-grad-norm", type=float, default=1.0)
    p.add_argument(
        "--max-train-steps",
        type=int,
        default=40,
        help="Optimizer steps; 40 is intentionally small for the first smoke pilot.",
    )
    p.add_argument(
        "--max-val-examples",
        type=int,
        default=0,
        help="0 means use all validation examples.",
    )
    p.add_argument(
        "--max-test-examples",
        type=int,
        default=0,
        help="0 means use all test examples.",
    )

    p.add_argument(
        "--output-dir",
        default=r".\output\qwen3vl_rupture_finetune_pilot\run1",
    )
    p.add_argument("--seed", type=int, default=42)

    p.add_argument(
        "--prepare-only",
        action="store_true",
        help="Only build and inspect the pilot manifest; do not load/train Qwen.",
    )

    return p


def main():
    parser = make_parser()
    args = parser.parse_args()

    # Normalize 0 -> None for evaluation limits.
    if args.max_val_examples <= 0:
        args.max_val_examples = None
    if args.max_test_examples <= 0:
        args.max_test_examples = None

    print("QWEN3-VL PATIENT RUPTURE-SALIENCE PILOT")
    print("=" * 72)
    print("Labels:", args.labels_csv)
    print("Video root:", args.video_root)
    print("Model:", args.model_id)

    manifest = build_pilot_manifest(args)

    if args.prepare_only:
        print("\nPREPARE-ONLY complete. No model was loaded.")
        return

    train(args, manifest)


if __name__ == "__main__":
    main()