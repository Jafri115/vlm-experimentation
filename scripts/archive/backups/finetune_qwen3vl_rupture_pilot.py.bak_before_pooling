class PatientCropper:
    """
    Reproduces the spirit of the frozen benchmark patient crop:
    - detect faces on sampled frames with YuNet
    - use the cached patient side (left/right)
    - estimate a median face box
    - expand to a person ROI
    - apply one fixed ROI to all sampled frames
    """

    def __init__(
        self,
        yunet_model: Path,
        output_width: int = 320,
        score_threshold: float = 0.60,
    ):
        if not yunet_model.exists():
            raise FileNotFoundError(
                f"YuNet model not found: {yunet_model}\n"
                "Use the same YuNet ONNX file used by the visual benchmark."
            )

        self.detector = cv2.FaceDetectorYN.create(
            model=str(yunet_model),
            config="",
            input_size=(320, 320),
            score_threshold=float(score_threshold),
            nms_threshold=0.30,
            top_k=5000,
        )
        self.output_width = int(output_width)

    def detect(self, image: Image.Image) -> List[Tuple[float, float, float, float]]:
        rgb = np.asarray(image.convert("RGB"))
        bgr = cv2.cvtColor(rgb, cv2.COLOR_RGB2BGR)
        h, w = bgr.shape[:2]

        self.detector.setInputSize((w, h))
        _, faces = self.detector.detect(bgr)

        if faces is None:
            return []

        boxes = []
        for f in faces:
            x, y, fw, fh = map(float, f[:4])
            if min(fw, fh) < 24:
                continue
            boxes.append((x, y, fw, fh))
        return boxes

    @staticmethod
    def bbox_center_x(box) -> float:
        x, y, w, h = box
        return x + w / 2.0

    def choose_face(
        self,
        frames: Sequence[Image.Image],
        side: str,
    ) -> Optional[Tuple[float, float, float, float]]:
        detections = []

        # Detect on up to 12 evenly spaced frames.
        idxs = np.linspace(
            0,
            len(frames) - 1,
            min(12, len(frames)),
            dtype=int,
        )

        frame_w = frames[0].width

        for idx in idxs:
            boxes = self.detect(frames[int(idx)])

            side_boxes = []
            for box in boxes:
                cx = self.bbox_center_x(box)
                this_side = "left" if cx < frame_w / 2.0 else "right"
                if this_side == side:
                    side_boxes.append(box)

            if side_boxes:
                # Prefer the largest face on the cached side.
                chosen = max(side_boxes, key=lambda b: b[2] * b[3])
                detections.append(chosen)

        if not detections:
            return None

        arr = np.asarray(detections, dtype=float)
        median = np.median(arr, axis=0)
        return tuple(map(float, median))

    @staticmethod
    def face_to_roi(
        face_box,
        frame_width: int,
        frame_height: int,
        width_mult: float = 4.5,
        top_mult: float = 1.0,
        bottom_mult: float = 5.0,
    ) -> Tuple[int, int, int, int]:
        x, y, w, h = face_box
        cx = x + w / 2.0

        roi_w = width_mult * w
        x1 = max(0.0, cx - roi_w / 2.0)
        x2 = min(float(frame_width), cx + roi_w / 2.0)
        y1 = max(0.0, y - top_mult * h)
        y2 = min(float(frame_height), y + h + bottom_mult * h)

        return (
            int(round(x1)),
            int(round(y1)),
            int(round(x2)),
            int(round(y2)),
        )

    @staticmethod
    def half_frame_roi(
        side: str,
        frame_width: int,
        frame_height: int,
    ) -> Tuple[int, int, int, int]:
        mid = frame_width // 2
        if side == "left":
            return (0, 0, min(frame_width, int(mid * 1.15)), frame_height)
        return (max(0, int(mid * 0.85)), 0, frame_width, frame_height)

    def resize(self, image: Image.Image) -> Image.Image:
        if image.width <= self.output_width:
            return image

        scale = self.output_width / float(image.width)
        new_h = max(32, int(round(image.height * scale)))

        # Keep dimensions friendly for the vision encoder.
        new_w = max(32, int(round(self.output_width / 32.0) * 32))
        new_h = max(32, int(round(new_h / 32.0) * 32))

        return image.resize(
            (new_w, new_h),
            Image.Resampling.LANCZOS,
        )

    def crop(
        self,
        frames: Sequence[Image.Image],
        side: str,
    ) -> List[Image.Image]:
        if not frames:
            raise ValueError("No frames to crop.")

        frame_w, frame_h = frames[0].size
        face = self.choose_face(frames, side)

        if face is not None:
            roi = self.face_to_roi(face, frame_w, frame_h)
        else:
            # A safe fallback for pilot preprocessing. The manifest records
            # patient side, so this remains patient-focused even if YuNet
            # misses the face in this particular minute.
            roi = self.half_frame_roi(side, frame_w, frame_h)

        out = []
        for frame in frames:
            cropped = frame.crop(roi)
            out.append(self.resize(cropped))
        return out


