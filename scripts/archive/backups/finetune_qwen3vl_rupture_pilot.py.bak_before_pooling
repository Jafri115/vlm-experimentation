def index_videos(video_root: Path) -> Tuple[Dict[str, Path], Dict[str, List[Path]]]:
    """
    Recursively map basename -> full path.
    Duplicate basenames are retained separately and reported.
    """
    if not video_root.exists():
        raise FileNotFoundError(f"Video root does not exist: {video_root}")

    all_videos = []
    for pattern in ("*.mp4", "*.MP4", "*.mov", "*.MOV", "*.mkv", "*.MKV"):
        all_videos.extend(video_root.rglob(pattern))

    by_name: Dict[str, Path] = {}
    duplicates: Dict[str, List[Path]] = {}

    for p in sorted(set(all_videos)):
        key = p.name.lower()
        if key in by_name:
            duplicates.setdefault(key, [by_name[key]]).append(p)
        else:
            by_name[key] = p

    return by_name, duplicates


def load_role_cache(path: Optional[Path]) -> Dict[str, dict]:
    if path is None or not path.exists():
        return {}
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        raise RuntimeError(f"Could not read role cache {path}: {exc}") from exc


def role_side_for_video(cache: Dict[str, dict], video_name: str) -> Optional[str]:
    candidates = [
        video_name,
        Path(video_name).name,
        Path(video_name).stem,
    ]

    lower_map = {str(k).lower(): v for k, v in cache.items()}

    for key in candidates:
        value = cache.get(key)
        if value is None:
            value = lower_map.get(str(key).lower())

        if isinstance(value, dict):
            side = value.get("patient_side")
            if side in {"left", "right"}:
                return side

    return None


def aggregate_labels(labels_csv: Path, min_coders: int) -> pd.DataFrame:
    raw = pd.read_csv(labels_csv)

    required = [
        "video",
        "patient_id",
        "session_id",
        "coder",
        "segment_id",
        "segment_start",
        "segment_end",
        "WD_P",
        "CF_P",
    ]
    missing = [c for c in required if c not in raw.columns]
    if missing:
        raise ValueError(f"Missing required CSV columns: {missing}")

    raw = raw.dropna(subset=["WD_P", "CF_P"]).copy()
    raw["patient_id"] = raw["patient_id"].map(normalize_id)
    raw["session_id"] = raw["session_id"].map(normalize_id)
    raw["video"] = raw["video"].astype(str).str.strip()

    group_cols = [
        "video",
        "patient_id",
        "session_id",
        "segment_id",
        "segment_start",
        "segment_end",
    ]

    grouped = (
        raw.groupby(group_cols, dropna=False)
        .agg(
            n_rows=("coder", "size"),
            n_coders=("coder", "nunique"),
            coders=("coder", lambda s: "|".join(sorted(set(map(str, s))))),
            WD_P_mean=("WD_P", "mean"),
            WD_P_min=("WD_P", "min"),
            WD_P_max=("WD_P", "max"),
            CF_P_mean=("CF_P", "mean"),
            CF_P_min=("CF_P", "min"),
            CF_P_max=("CF_P", "max"),
        )
        .reset_index()
    )

    grouped = grouped[grouped["n_coders"] >= int(min_coders)].copy()

    grouped["WD_P_disagreement"] = (
        grouped["WD_P_max"] - grouped["WD_P_min"]
    )
    grouped["CF_P_disagreement"] = (
        grouped["CF_P_max"] - grouped["CF_P_min"]
    )

    start_secs = []
    end_secs = []

    for row in grouped.itertuples(index=False):
        start = parse_hms(row.segment_start)
        end_inclusive = parse_hms(row.segment_end)

        # Annotation files use boundaries such as 00:00:00 -> 00:00:59.
        # Convert to half-open [start, end) timing by adding one second.
        end = end_inclusive + 1.0

        if end <= start:
            end = start + 60.0

        start_secs.append(start)
        end_secs.append(end)

    grouped["start_sec"] = start_secs
    grouped["end_sec"] = end_secs

    return grouped


def resolve_media(
    segments: pd.DataFrame,
    video_root: Path,
    role_cache: Dict[str, dict],
    require_role_cache: bool,
) -> pd.DataFrame:
    index, duplicates = index_videos(video_root)

    if duplicates:
        print(
            f"WARNING: {len(duplicates)} duplicate video basenames found. "
            "The first sorted path will be used.",
            flush=True,
        )

    paths = []
    sides = []
    exists = []

    for row in segments.itertuples(index=False):
        name = Path(str(row.video)).name
        path = index.get(name.lower())
        side = role_side_for_video(role_cache, name)

        paths.append(str(path) if path else "")
        sides.append(side or "")
        exists.append(path is not None)

    out = segments.copy()
    out["video_path"] = paths
    out["patient_side"] = sides
    out["video_found"] = exists

    before = len(out)
    out = out[out["video_found"]].copy()

    print(
        f"Resolved videos: {len(out)}/{before} double-rated segments",
        flush=True,
    )

    if require_role_cache:
        before = len(out)
        out = out[out["patient_side"].isin(["left", "right"])].copy()
        print(
            f"Role-cache filter: {len(out)}/{before} segments retained",
            flush=True,
        )

    return out


def choose_pilot_patients(
    candidates: pd.DataFrame,
    pilot_patients: int,
    positive_threshold: float,
    seed: int,
) -> List[str]:
    temp = candidates.copy()
    temp["rupture_any"] = (
        temp[["WD_P_mean", "CF_P_mean"]].max(axis=1)
        >= positive_threshold
    )

    stats = (
        temp.groupby("patient_id")
        .agg(
            n_segments=("segment_id", "size"),
            n_positive=("rupture_any", "sum"),
            n_videos=("video", "nunique"),
        )
        .reset_index()
    )

    # Favor patients that provide both enough data and some positive segments,
    # but use a deterministic random tie-breaker.
    rng = np.random.default_rng(seed)
    stats["_jitter"] = rng.uniform(0, 1, len(stats))
    stats = stats.sort_values(
        ["n_positive", "n_segments", "_jitter"],
        ascending=[False, False, True],
    )

    if len(stats) < pilot_patients:
        print(
            f"WARNING: requested {pilot_patients} pilot patients but only "
            f"{len(stats)} are available after filtering.",
            flush=True,
        )

    return stats.head(pilot_patients)["patient_id"].astype(str).tolist()


def assign_patient_splits(
    patient_ids: Sequence[str],
    candidates: pd.DataFrame,
    positive_threshold: float,
    seed: int,
) -> Dict[str, str]:
    """
    Patient-disjoint pilot split:
      >= 5 patients: roughly 75% train, >=1 val, >=1 test.
    We preferentially reserve patients that contain at least one positive
    for val/test so the pilot metrics are not trivially all-negative.
    """
    ids = list(dict.fromkeys(map(str, patient_ids)))
    if len(ids) < 3:
        raise ValueError("Need at least 3 patients for train/val/test.")

    temp = candidates[candidates["patient_id"].isin(ids)].copy()
    temp["positive"] = (
        temp[["WD_P_mean", "CF_P_mean"]].max(axis=1)
        >= positive_threshold
    )

    stats = (
        temp.groupby("patient_id")
        .agg(n=("segment_id", "size"), pos=("positive", "sum"))
        .reset_index()
    )

    rng = np.random.default_rng(seed + 17)
    stats["_jitter"] = rng.uniform(0, 1, len(stats))

    positive_patients = stats[stats["pos"] > 0].sort_values(
        ["pos", "n", "_jitter"],
        ascending=[False, False, True],
    )

    if len(positive_patients) >= 2:
        # Do not reserve the single strongest positive patient if possible.
        reserved = positive_patients.iloc[1:3]["patient_id"].astype(str).tolist()
        if len(reserved) < 2:
            reserved = positive_patients.head(2)["patient_id"].astype(str).tolist()
    else:
        shuffled = stats.sample(frac=1.0, random_state=seed)
        reserved = shuffled.head(2)["patient_id"].astype(str).tolist()

    val_patient, test_patient = reserved[0], reserved[1]

    split_map = {}
    for pid in ids:
        if pid == val_patient:
            split_map[pid] = "val"
        elif pid == test_patient:
            split_map[pid] = "test"
        else:
            split_map[pid] = "train"

    return split_map


def sample_patient_segments(
    patient_df: pd.DataFrame,
    quota: int,
    positive_threshold: float,
    seed: int,
    split: str,
) -> pd.DataFrame:
    """
    Small pilot sampling. Training is mildly positive-enriched to ensure
    the model sees enough rupture-marker examples. Validation/test are less
    aggressively enriched but still guarantee some positives when available.

    This is for pipeline validation, NOT final prevalence estimation.
    """
    if len(patient_df) <= quota:
        return patient_df.copy()

    rng = np.random.default_rng(seed)

    work = patient_df.copy()
    work["_positive"] = (
        work[["WD_P_mean", "CF_P_mean"]].max(axis=1)
        >= positive_threshold
    )

    pos = work[work["_positive"]].copy()
    neg = work[~work["_positive"]].copy()

    if split == "train":
        desired_pos = min(len(pos), max(2, quota // 2))
    else:
        desired_pos = min(len(pos), max(1, quota // 3))

    selected = []

    if desired_pos > 0:
        take = rng.choice(
            pos.index.to_numpy(),
            size=desired_pos,
            replace=False,
        )
        selected.extend(take.tolist())

    remaining = quota - len(selected)

    pool = work.drop(index=selected)
    if remaining > 0 and len(pool) > 0:
        take_n = min(remaining, len(pool))
        take = rng.choice(
            pool.index.to_numpy(),
            size=take_n,
            replace=False,
        )
        selected.extend(take.tolist())

    result = work.loc[selected].drop(columns=["_positive"])
    return result.copy()


def build_pilot_manifest(args) -> pd.DataFrame:
    print("\nPREPARING PILOT MANIFEST")
    print("=" * 72)

    labels_csv = Path(args.labels_csv)
    video_root = Path(args.video_root)
    role_cache_path = Path(args.role_cache) if args.role_cache else None

    grouped = aggregate_labels(labels_csv, args.min_coders)

    print(f"Double-rated candidate segments: {len(grouped)}")
    print(f"Patients before media filtering: {grouped['patient_id'].nunique()}")

    role_cache = load_role_cache(role_cache_path)

    candidates = resolve_media(
        grouped,
        video_root=video_root,
        role_cache=role_cache,
        require_role_cache=args.require_role_cache,
    )

    if candidates.empty:
        raise RuntimeError(
            "No candidate segments remain after video/role-cache filtering."
        )

    selected_patients = choose_pilot_patients(
        candidates,
        pilot_patients=args.pilot_patients,
        positive_threshold=args.positive_threshold,
        seed=args.seed,
    )

    split_map = assign_patient_splits(
        selected_patients,
        candidates,
        positive_threshold=args.positive_threshold,
        seed=args.seed,
    )

    pieces = []

    for i, pid in enumerate(selected_patients):
        p = candidates[candidates["patient_id"] == pid].copy()
        p["split"] = split_map[pid]

        sampled = sample_patient_segments(
            p,
            quota=args.segments_per_patient,
            positive_threshold=args.positive_threshold,
            seed=args.seed + i * 101,
            split=split_map[pid],
        )
        pieces.append(sampled)

    manifest = pd.concat(pieces, ignore_index=True)

    manifest["rupture_any"] = (
        manifest[["WD_P_mean", "CF_P_mean"]].max(axis=1)
        >= args.positive_threshold
    ).astype(int)

    manifest["sample_id"] = manifest.apply(
        lambda r: (
            f"{Path(str(r['video'])).stem}"
            f"_seg{int(r['segment_id']):03d}"
        ),
        axis=1,
    )

    keep_cols = [
        "sample_id",
        "split",
        "video",
        "video_path",
        "patient_id",
        "session_id",
        "segment_id",
        "segment_start",
        "segment_end",
        "start_sec",
        "end_sec",
        "patient_side",
        "n_coders",
        "coders",
        "WD_P_mean",
        "CF_P_mean",
        "WD_P_disagreement",
        "CF_P_disagreement",
        "rupture_any",
    ]
    manifest = manifest[keep_cols].sort_values(
        ["split", "patient_id", "video", "segment_id"]
    ).reset_index(drop=True)

    out_path = Path(args.manifest_out)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    manifest.to_csv(out_path, index=False)

    print(f"\nSaved pilot manifest: {out_path}")
    print(f"Total pilot segments: {len(manifest)}")
    print(f"Patients: {manifest['patient_id'].nunique()}")

    print("\nSplit summary")
    summary = (
        manifest.groupby("split")
        .agg(
            segments=("sample_id", "size"),
            patients=("patient_id", "nunique"),
            rupture_any=("rupture_any", "sum"),
            WD_P_mean=("WD_P_mean", "mean"),
            CF_P_mean=("CF_P_mean", "mean"),
        )
    )
    print(summary.to_string())

    print("\nPatient split")
    patient_split = (
        manifest[["patient_id", "split"]]
        .drop_duplicates()
        .sort_values(["split", "patient_id"])
    )
    print(patient_split.to_string(index=False))

    return manifest


